---
const links = [
  { href: '/', label: 'Home' },
  { href: '/people/', label: 'People' },
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <circle cx="14" cy="14" r="12" fill="none" stroke="#84C8FF" stroke-width="1.5"></circle>
        <circle cx="9" cy="16" r="3" fill="#FFC72C"></circle>
        <circle cx="18" cy="10" r="3" fill="#FFC72C"></circle>
      </svg>
      <span>Dancing Electrons</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
