---
const links = [
  { href: '/', label: 'Home' },
  { href: '/people/', label: 'People' },
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
];
const here = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? here === '/' : here.startsWith(href));
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/dancing-electrons-logo-v12.png" width="28" height="28" alt="" aria-hidden="true" />
      <span>Dancing Electrons</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
