---
// Static hero graphic: a triangular Wigner crystal of electrons sitting on the
// moiré superlattice formed by two twisted atomic lattices. Drawn once on a
// canvas (and again on resize); no animation.
---
<div class="moire" data-moire>
  <canvas class="moire__canvas" aria-label="Two twisted atomic lattices forming a moiré pattern, with a triangular crystal of electrons on the moiré sites"></canvas>
</div>

<style>
  .moire { width: min(100%, 540px); aspect-ratio: 1; margin: 0 auto; }
  .moire__canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  const host = document.querySelector<HTMLElement>('[data-moire]');
  const canvas = host?.querySelector('canvas');
  if (host && canvas) {
    const ctx = canvas.getContext('2d')!;
    const LIGHT = '#84C8FF', MID = '#2E96FF', GOLD = '#FFC72C';
    const A = 22;                       // atomic lattice constant, px at 540
    const THETA = 9 * Math.PI / 180;    // twist angle; sets the crystal period a/(2 sin(θ/2))
    let size = 540, dpr = 1;

    function resize() {
      const rect = host!.getBoundingClientRect();
      size = Math.max(200, Math.round(rect.width));
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas!.width = size * dpr; canvas!.height = size * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function lattice(color: string, rot: number) {
      const s = size / 540, a = A * s, h = a * Math.sqrt(3) / 2, R = size / 2;
      ctx.save();
      ctx.translate(R, R); ctx.rotate(rot);
      ctx.fillStyle = color;
      const n = Math.ceil(R / h) + 2;
      for (let j = -n; j <= n; j++) {
        const y = j * h, off = (j & 1) ? a / 2 : 0;
        for (let i = -n - 1; i <= n + 1; i++) {
          const x = i * a + off;
          if (x * x + y * y > R * R) continue;
          ctx.beginPath(); ctx.arc(x, y, 1.5 * s, 0, Math.PI * 2); ctx.fill();
        }
      }
      ctx.restore();
    }

    // Moiré superlattice sites for twist th: triangular, period a/(2 sin(th/2)),
    // rotated by th/2 + 30 degrees relative to the first lattice, with a site at the origin.
    function sites(th: number) {
      const s = size / 540, a = A * s, R = size / 2;
      const L = a / (2 * Math.sin(th / 2));
      const phi = th / 2 + Math.PI / 6;
      const v1 = [L * Math.cos(phi), L * Math.sin(phi)];
      const v2 = [L * Math.cos(phi + Math.PI / 3), L * Math.sin(phi + Math.PI / 3)];
      const out: [number, number][] = [];
      const n = Math.ceil(R / L) + 1;
      for (let m = -n; m <= n; m++) for (let k = -n; k <= n; k++) {
        const x = m * v1[0] + k * v2[0], y = m * v1[1] + k * v2[1];
        if (x * x + y * y <= (R - 12 * s) * (R - 12 * s)) out.push([x, y]);
      }
      return out;
    }

    function draw() {
      const R = size / 2, s = size / 540;
      ctx.clearRect(0, 0, size, size);
      lattice(LIGHT, 0);
      lattice(MID, THETA);
      const g = ctx.createRadialGradient(R, R, R * 0.55, R, R, R);
      g.addColorStop(0, 'rgba(0,0,0,1)'); g.addColorStop(1, 'rgba(0,0,0,0)');
      ctx.globalCompositeOperation = 'destination-in';
      ctx.fillStyle = g; ctx.fillRect(0, 0, size, size);
      ctx.globalCompositeOperation = 'source-over';
      ctx.save(); ctx.translate(R, R);
      ctx.fillStyle = GOLD; ctx.shadowColor = GOLD; ctx.shadowBlur = 14 * s;
      for (const [x, y] of sites(THETA)) {
        const d = Math.hypot(x, y) / R;
        ctx.globalAlpha = Math.max(0, 1 - Math.pow(d, 3));
        ctx.beginPath(); ctx.arc(x, y, 7 * s, 0, Math.PI * 2); ctx.fill();
      }
      ctx.restore();
      ctx.globalAlpha = 1; ctx.shadowBlur = 0;
    }

    resize(); draw();
    window.addEventListener('resize', () => { resize(); draw(); });
  }
</script>
